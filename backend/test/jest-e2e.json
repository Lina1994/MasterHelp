{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/**/*.(t|j)s"
  ],
  "coverageDirectory": "../coverage-e2e",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 1,
  "moduleNameMapper": {
    "^src/(.*)": "<rootDir>/src/$1"
  }
}
