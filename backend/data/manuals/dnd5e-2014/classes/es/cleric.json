{
  "id": "cleric",
  "name": "Clérigo",
  "source": "PHB 2014 / SRD 5.1",
  "hitDie": 8,
  "hitPoints": {
    "hitDice": "1d8 por nivel de clérigo",
    "at1stLevel": "8 + tu modificador de Constitución",
    "atHigherLevels": "1d8 (o 5) + tu modificador de Constitución por cada nivel de clérigo después del 1º"
  },
  "primaryAbilities": ["wis"],
  "savingThrows": ["wis", "cha"],
  "proficiencies": {
    "armor": ["Armadura ligera", "Armadura media", "Escudos"],
    "weapons": ["Armas simples"],
    "tools": []
  },
  "skills": { "choose": 2, "from": ["Historia", "Perspicacia", "Medicina", "Persuasión", "Religión"] },
  "equipment": [
    { "choose": 1, "options": [
      { "id": "mace", "description": "Una maza" },
      { "id": "warhammer", "description": "Un martillo de guerra (si eres competente)" }
    ]},
    { "choose": 1, "options": [
      { "id": "scale_mail", "description": "Cota de escamas" },
      { "id": "leather_armor", "description": "Armadura de cuero" },
      { "id": "chain_mail", "description": "Cota de mallas (si eres competente)" }
    ]},
    { "choose": 1, "options": [
      { "id": "light_crossbow", "description": "Una ballesta ligera y 20 virotes" },
      { "id": "simple_weapon", "description": "Cualquier arma simple" }
    ]},
    { "choose": 1, "options": [
      { "id": "priests_pack", "description": "Equipo de Sacerdote" },
      { "id": "explorers_pack", "description": "Equipo de Explorador" }
    ]},
    { "choose": 1, "options": [
      { "id": "shield_holy_symbol", "description": "Un escudo y un símbolo sagrado" },
      { "id": "holy_symbol", "description": "Un símbolo sagrado" }
    ]}
  ],
  "features": [
    {
      "id": "cleric_spellcasting",
      "name": "Conjuración",
      "level": 1,
      "description": "Has aprendido a canalizar magia divina mediante meditación y oración. Sabiduría es tu característica de conjuro; preparas conjuros de clérigo igual a tu modificador de Sabiduría + tu nivel de clérigo (mínimo 1).",
      "effects": [ { "type": "spellcasting", "ability": "wis", "prepareFormula": "SAB mod + nivel", "progression": "full" } ]
    },
    {
      "id": "divine_domain",
      "name": "Dominio Divino",
      "level": 1,
      "description": "Elige un dominio divino que moldea tu práctica de magia clerical. Te otorga rasgos en niveles 1, 2, 6, 8 y 17.",
      "effects": [ { "type": "choose_subclass", "atLevel": 1 } ]
    },
    {
      "id": "channel_divinity",
      "name": "Canalizar Divinidad",
      "level": 2,
      "description": "Puedes canalizar energía divina para potenciar efectos mágicos. Comienzas con un uso; recuperas usos al finalizar un descanso corto o largo.",
      "effects": [ { "type": "resource", "name": "Canalizar Divinidad", "per": "short_rest", "uses": 1 } ]
    },
    {
      "id": "turn_undead",
      "name": "Ahuyentar a los No Muertos",
      "level": 2,
      "description": "Como acción, presentas tu símbolo sagrado y pronuncias una plegaria que reprende a los no muertos. Cada no muerto que pueda verte u oírte a 30 pies realiza una TS de Sabiduría; con fallo, queda ahuyentado 1 minuto o hasta que reciba daño.",
      "effects": [ { "type": "turn_undead", "range": 30, "save": { "ability": "wis", "dcFormula": "8 + PB + SAB" }, "duration": "1 minuto" } ]
    },
    {
      "id": "destroy_undead",
      "name": "Destruir No Muertos",
      "level": 5,
      "description": "Cuando un no muerto falla la TS contra Ahuyentar, queda destruido si su ND está por debajo del umbral (ND 1/2 a 5, ND 1 a 8, ND 2 a 11, ND 3 a 14).",
      "effects": [ { "type": "destroy_undead_cr_max", "byLevel": { "5": 0.5, "8": 1, "11": 2, "14": 3 } } ]
    },
    {
      "id": "ability_score_improvement",
      "name": "Mejora de Puntuación de Característica",
      "level": 4,
      "description": "En los niveles 4, 8, 12, 16 y 19, puedes aumentar una puntuación de característica en 2, o dos puntuaciones en 1. No puedes superar 20 con este rasgo. Alternativamente, puedes elegir un dote si tu mesa los utiliza."
    },
    {
      "id": "divine_intervention",
      "name": "Intervención Divina",
      "level": 10,
      "description": "Puedes pedir a tu deidad que intervenga cuando la necesidad sea grande. Tira porcentaje; si el resultado es menor o igual a tu nivel de clérigo, tu deidad interviene. Si tiene éxito, no puedes volver a usar este rasgo durante 7 días.",
      "effects": [ { "type": "divine_intervention", "successRoll": "<= nivel", "cooldown": "7 días" } ]
    },
    {
      "id": "improved_divine_intervention",
      "name": "Intervención Divina Mejorada",
      "level": 20,
      "description": "Tu petición de intervención tiene éxito automáticamente, sin tirada.",
      "effects": [ { "type": "divine_intervention_auto", "value": true } ]
    }
  ],
