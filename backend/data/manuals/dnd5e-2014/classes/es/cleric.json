  "subclasses": [
    {
      "id": "life_domain",
      "name": "Dominio de la Vida",
      "grantedAtLevel": 1,
      "description": "El Dominio de la Vida se centra en la vitalidad, la salud y la sanación.",
      "features": [
        { "id": "life_bonus_proficiency", "name": "Competencia Adicional", "level": 1, "description": "Ganas competencia con armadura pesada." },
        { "id": "disciple_of_life", "name": "Discípulo de la Vida", "level": 1, "description": "Tus conjuros de curación son más efectivos. Siempre que uses un conjuro de 1.º nivel o superior para restaurar PG a una criatura, recupera PG adicionales iguales a 2 + el nivel del conjuro." },
        { "id": "preserve_life", "name": "Canalizar Divinidad: Preservar la Vida", "level": 2, "description": "Puedes usar Canalizar Divinidad para curar PG totales iguales a cinco veces tu nivel de clérigo, distribuidos entre criaturas a 30 pies de ti." },
        { "id": "blessed_healer", "name": "Sanador Bendito", "level": 6, "description": "Cuando lanzas un conjuro de 1.º nivel o superior que restaura PG a una criatura distinta de ti, tú también recuperas PG iguales a 2 + el nivel del conjuro." },
        { "id": "divine_strike_life", "name": "Golpe Divino", "level": 8, "description": "Una vez por turno, cuando golpeas con un ataque de arma, puedes hacer que inflija 1d8 de daño radiante adicional (2d8 a nivel 14)." },
        { "id": "supreme_healing", "name": "Sanación Suprema", "level": 17, "description": "Cuando normalmente tirarías uno o más dados para restaurar PG con un conjuro, usas el valor máximo posible de cada dado." }
      ]
    }
  ],
