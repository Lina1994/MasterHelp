    "armor": ["Armadura Ligera (no metal)", "Armadura Media (no metal)", "Escudos (no metal)"] ,
    "weapons": ["Porras", "Dagas", "Dardos", "Jabalinas", "Mazas", "Bastones", "Cimitarra", "Hoz", "Hondas", "Lanzas"],
    "tools": ["Kit de Herboristería"]
  },
  "skills": { "choose": 2, "from": ["Arcanos", "Adiestrar Animales", "Perspicacia", "Medicina", "Naturaleza", "Percepción", "Religión", "Supervivencia"] },
  "equipment": [
    { "choose": 1, "options": [ { "id": "shield", "description": "Un escudo de madera" }, { "id": "simple_weapon", "description": "Cualquier arma sencilla" } ] },
    { "choose": 1, "options": [ { "id": "scimitar", "description": "Una cimitarra" }, { "id": "simple_melee", "description": "Cualquier arma cuerpo a cuerpo sencilla" } ] },
    { "choose": 1, "options": [ { "id": "explorers_pack", "description": "Equipo de Explorador" }, { "id": "dungeoneers_pack", "description": "Equipo de Mazmorrero" } ] },
    { "id": "leather_armor", "description": "Armadura de cuero" },
    { "id": "herbalism_kit", "description": "Un kit de herboristería" }
  ],
  "features": [
    {
      "id": "druid_spellcasting",
      "name": "Conjuración",
      "level": 1,
      "description": "Puedes lanzar conjuros de druida preparados de la lista de druida. SAB es tu característica de conjuro. Puedes lanzar conjuros de druida como rituales.",
      "effects": [ { "type": "spellcasting", "ability": "wis", "progression": "full", "ritualCasting": true, "prepareFormula": "MOD SAB + nivel de druida" } ]
    },
    {
      "id": "druidic",
      "name": "Druídico",
      "level": 1,
      "description": "Conoces el druídico, el lenguaje secreto de los druidas. Puedes dejar mensajes ocultos que solo los druidas detectan y descifran."
    },
    {
      "id": "wild_shape",
      "name": "Forma Salvaje",
      "level": 2,
      "description": "Puedes usar tu acción para adoptar mágicamente la forma de una bestia que hayas visto, con limitaciones de CR y movimiento que mejoran a niveles 4 y 8.",
      "effects": [ { "type": "resource", "name": "Forma Salvaje", "uses": 2, "per": "short_rest" } ]
    },
    {
      "id": "druid_circle",
      "name": "Círculo de Druida",
      "level": 2,
      "description": "Eliges un círculo de druida, como Círculo de la Tierra o Círculo de la Luna.",
      "effects": [ { "type": "choose_subclass", "atLevel": 2 } ]
    },
    {
      "id": "ability_score_improvement",
      "name": "Mejora de Característica",
      "level": 4,
      "description": "A 4º nivel, y de nuevo a 8º, 12º, 16º y 19º, aumentas una característica en 2 o dos en 1, o tomas un dote si se usan."
    },
    {
      "id": "timeless_body",
      "name": "Cuerpo Eterno",
      "level": 18,
      "description": "Tu cuerpo envejece más lentamente, no sufres la fragilidad de la vejez y no puedes envejecer mágicamente."
    },
    {
      "id": "beast_spells",
      "name": "Conjuros de Bestia",
      "level": 18,
      "description": "Puedes lanzar muchos de tus conjuros de druida en cualquier forma que adoptes con Forma Salvaje, con restricciones de componentes materiales."
    },
    {
      "id": "archdruid",
      "name": "Arquidruida",
      "level": 20,
      "description": "Puedes usar tu Forma Salvaje un número ilimitado de veces. Además, ignoras componentes verbales y somáticos de los conjuros de druida mientras estés en forma de bestia."
    }
  ],
