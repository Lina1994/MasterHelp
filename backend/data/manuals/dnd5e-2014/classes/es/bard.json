  "features": [
    {
      "id": "bard_spellcasting",
      "name": "Conjuración",
      "level": 1,
      "description": "Has aprendido a entrelazar y remodelar la realidad en armonía con tus deseos y tu música. Carisma es tu característica de conjuro.",
      "effects": [ { "type": "spellcasting", "ability": "cha", "progression": "full" } ]
    },
    {
      "id": "bardic_inspiration",
      "name": "Inspiración Bárdica",
      "level": 1,
      "description": "Puedes inspirar a otros con palabras o música. Como acción adicional, una criatura a 60 pies (que no seas tú) gana un dado de Inspiración Bárdica (d6). Usos iguales a tu modificador de Carisma (mínimo 1), se recuperan con un descanso largo; el dado aumenta a d8 (5º), d10 (10º) y d12 (15º).",
      "effects": [ { "type": "resource", "name": "Inspiración Bárdica", "per": "long_rest", "usesFormula": "max(1, MOD CAR)", "dieByLevel": { "1": 6, "5": 8, "10": 10, "15": 12 } } ]
    },
    {
      "id": "jack_of_all_trades",
      "name": "Aprendiz de Todo",
      "level": 2,
      "description": "Puedes añadir la mitad de tu bonificación por competencia, redondeada hacia abajo, a cualquier prueba de característica que hagas y que no incluya ya tu competencia."
    },
    {
      "id": "song_of_rest",
      "name": "Canción de Descanso",
      "level": 2,
      "description": "A partir de 2º nivel, si tú o criaturas aliadas que puedan oír tu interpretación recuperan PG al final de un descanso corto, cada una recupera 1d6 PG adicionales. Aumenta a d8 (9º), d10 (13º) y d12 (17º).",
      "effects": [ { "type": "healing_bonus_short_rest", "dieByLevel": { "2": 6, "9": 8, "13": 10, "17": 12 } } ]
    },
    {
      "id": "expertise",
      "name": "Pericia",
      "level": 3,
      "description": "Elige dos de tus competencias en habilidades. Duplicas tu bonificación por competencia en las pruebas que usen esas habilidades. A 10º nivel, elige otras dos habilidades para ganar este beneficio.",
      "effects": [ { "type": "expertise", "choose": 2, "atLevel": 3 }, { "type": "expertise", "choose": 2, "atLevel": 10 } ]
    },
    {
      "id": "bard_college",
      "name": "Colegio de Bardo",
      "level": 3,
      "description": "Te adentras en las técnicas avanzadas de un colegio bárdico a tu elección.",
      "effects": [ { "type": "choose_subclass", "atLevel": 3 } ]
    },
    {
      "id": "ability_score_improvement",
      "name": "Mejora de Característica",
      "level": 4,
      "description": "A 4º nivel, y de nuevo a 8º, 12º, 16º y 19º, puedes aumentar una característica en 2, o dos en 1, o elegir un dote si está disponible."
    },
    {
      "id": "font_of_inspiration",
      "name": "Fuente de Inspiración",
      "level": 5,
      "description": "Desde 5º nivel, recuperas los usos gastados de Inspiración Bárdica cuando terminas un descanso corto o largo.",
      "effects": [ { "type": "resource_refresh_change", "resource": "Inspiración Bárdica", "per": "short_rest" } ]
    },
    {
      "id": "countercharm",
      "name": "Contraconjuro Musical",
      "level": 6,
      "description": "Usas notas musicales o palabras de poder para interrumpir efectos que influyen la mente. Como acción, interpretas hasta el final de tu próximo turno; tú y aliados a 30 pies tenéis ventaja en TS contra asustado o hechizado."
    },
    {
      "id": "magical_secrets_10",
      "name": "Secretos Mágicos",
      "level": 10,
      "description": "Aprendes dos conjuros a tu elección de cualquier clase. Deben ser de un nivel que puedas lanzar (o trucos).",
      "effects": [ { "type": "magical_secrets", "count": 2, "atLevel": 10 } ]
    },
    {
      "id": "magical_secrets_14",
      "name": "Secretos Mágicos",
