  "features": [
    {
      "id": "wizard_spellcasting",
      "name": "Conjuración",
      "level": 1,
      "description": "Tienes un libro de conjuros con conjuros que muestran los primeros destellos de tu verdadero poder. INT es tu característica de conjuro; puedes lanzar rituales y preparas una lista de conjuros de mago cada día.",
      "effects": [ { "type": "spellcasting", "ability": "int", "ritualCasting": true, "prepareFormula": "MOD INT + nivel de mago", "progression": "full", "usesSpellbook": true } ]
    },
    {
      "id": "arcane_recovery",
      "name": "Recuperación Arcana",
      "level": 1,
      "description": "Una vez al día al terminar un descanso corto, recuperas espacios de conjuro cuyo nivel combinado sea igual o menor que la mitad de tu nivel de mago (redondeado hacia arriba), ninguno de 6º nivel o superior."
    },
    {
      "id": "arcane_tradition",
      "name": "Tradición Arcana",
      "level": 2,
      "description": "Eliges una tradición arcana que moldea tu práctica de magia (p. ej., Escuela de Evocación).",
      "effects": [ { "type": "choose_subclass", "atLevel": 2 } ]
    },
    {
      "id": "ability_score_improvement",
      "name": "Mejora de Puntuación de Característica",
      "level": 4,
      "description": "Al alcanzar ciertos niveles (4, 8, 12, 16 y 19), puedes aumentar una puntuación de característica en 2, o dos puntuaciones en 1, hasta un máximo de 20. Alternativamente, puedes elegir un dote si tu mesa los utiliza."
    },
    {
      "id": "spell_mastery",
      "name": "Maestría de Conjuros",
      "level": 18,
      "description": "Has alcanzado tal maestría con ciertos conjuros que puedes lanzarlos a voluntad. Elige un conjuro de 1º nivel y uno de 2º nivel de mago que puedes lanzar sin gastar espacio (con restricciones)."
    },
    {
      "id": "signature_spells",
      "name": "Conjuros Insignia",
      "level": 20,
      "description": "Obtienes dos conjuros de mago de 3º nivel como conjuros insignia. Siempre los tienes preparados, no cuentan contra tus conjuros preparados, y puedes lanzar cada uno una vez a 3º nivel sin gastar espacio."
    }
  ],
