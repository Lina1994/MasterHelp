  "features": [
    {
      "id": "otherworldly_patron",
      "name": "Otherworldly Patron",
      "level": 1,
      "description": "You have struck a bargain with an otherworldly being; choose a patron such as The Fiend, The Archfey, or The Great Old One.",
      "effects": [ { "type": "choose_subclass", "atLevel": 1 } ]
    },
    {
      "id": "pact_magic",
      "name": "Pact Magic",
      "level": 1,
      "description": "You draw on your patron’s power to cast spells. CHA is your spellcasting ability. You know spells and cantrips, using Pact Magic slots that recover on a short rest.",
      "effects": [ { "type": "spellcasting", "ability": "cha", "progression": "pact", "ritualCasting": false } ]
    },
    {
      "id": "eldritch_invocations",
      "name": "Eldritch Invocations",
      "level": 2,
      "description": "You learn eldritch invocations, mystic enhancements that grant you magical abilities."
    },
    {
      "id": "pact_boon",
      "name": "Pact Boon",
      "level": 3,
      "description": "Your otherworldly patron bestows a boon: Pact of the Chain, Blade, or Tome."
    },
    {
      "id": "ability_score_improvement",
      "name": "Ability Score Improvement",
      "level": 4,
      "description": "At 4th, 8th, 12th, 16th, and 19th levels, increase one ability by 2, or two abilities by 1 each, or take a feat if used."
    },
    {
      "id": "mystic_arcanum_11",
      "name": "Mystic Arcanum (6th)",
      "level": 11,
      "description": "You gain one 6th-level spell that you can cast once per long rest without expending a spell slot."
    },
    {
      "id": "mystic_arcanum_13",
      "name": "Mystic Arcanum (7th)",
