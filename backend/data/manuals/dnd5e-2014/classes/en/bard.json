  ],
  "subclasses": [
    {
      "id": "college_of_lore",
      "name": "College of Lore",
      "grantedAtLevel": 3,
      "description": "Bards of the College of Lore know something about most things, collecting bits of knowledge from sources as diverse as scholarly tomes and peasant tales.",
      "features": [
        { "id": "bonus_proficiencies_lore", "name": "Bonus Proficiencies", "level": 3, "description": "You gain proficiency with three skills of your choice." },
        { "id": "cutting_words", "name": "Cutting Words", "level": 3, "description": "You can use your reaction to expend one use of Bardic Inspiration to subtract from an attack roll, ability check, or damage roll of a creature." },
        { "id": "additional_magical_secrets_lore", "name": "Additional Magical Secrets", "level": 6, "description": "You learn two additional spells of your choice from any class." },
        { "id": "peerless_skill", "name": "Peerless Skill", "level": 14, "description": "When you make an ability check, you can expend one use of Bardic Inspiration to add the number rolled to the check." }
      ]
    }
  ],
  "spellcasting": { "ability": "cha", "progression": "full", "cantripsKnown": 2, "cantripsKnownUpgrades": { "4": 3, "10": 4 } },
