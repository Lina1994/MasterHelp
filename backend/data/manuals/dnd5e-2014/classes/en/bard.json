    { "level": 8,  "proficiencyBonus": 3, "features": ["ability_score_improvement"],                         "cantripsKnown": 3, "knownSpellsCount": 11, "spellSlots": { "1": 4, "2": 3, "3": 3, "4": 2, "5": 0, "6": 0, "7": 0, "8": 0, "9": 0 } },
