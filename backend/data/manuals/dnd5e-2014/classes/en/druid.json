{
  "id": "druid",
  "name": "Druid",
  "source": "PHB 2014 / SRD 5.1",
  "hitDie": 8,
  "hitPoints": {
    "hitDice": "1d8 per druid level",
    "at1stLevel": "8 + your Constitution modifier",
    "atHigherLevels": "1d8 (or 5) + your Constitution modifier per druid level after 1st"
  },
  "primaryAbilities": ["wis"],
  "savingThrows": ["int", "wis"],
  "proficiencies": {
    "armor": ["Light Armor (nonmetal)", "Medium Armor (nonmetal)", "Shields (nonmetal)"] ,
    "weapons": ["Clubs", "Daggers", "Darts", "Javelins", "Maces", "Quarterstaffs", "Scimitars", "Sickles", "Slings", "Spears"],
    "tools": ["Herbalism Kit"]
  },
  "skills": { "choose": 2, "from": ["Arcana", "Animal Handling", "Insight", "Medicine", "Nature", "Perception", "Religion", "Survival"] },
  "equipment": [
    { "choose": 1, "options": [ { "id": "shield", "description": "A wooden shield" }, { "id": "simple_weapon", "description": "Any simple weapon" } ] },
    { "choose": 1, "options": [ { "id": "scimitar", "description": "A scimitar" }, { "id": "simple_melee", "description": "Any simple melee weapon" } ] },
    { "choose": 1, "options": [ { "id": "explorers_pack", "description": "Explorer's Pack" }, { "id": "dungeoneers_pack", "description": "Dungeoneer's Pack" } ] },
    { "id": "leather_armor", "description": "Leather armor" },
    { "id": "herbalism_kit", "description": "A herbalism kit" }
  ],
  "features": [
    {
      "id": "druid_spellcasting",
      "name": "Spellcasting",
      "level": 1,
      "description": "You can cast druid spells prepared from the druid list. WIS is your spellcasting ability. You can cast druid spells as rituals.",
      "effects": [ { "type": "spellcasting", "ability": "wis", "progression": "full", "ritualCasting": true, "prepareFormula": "WIS mod + druid level" } ]
    },
    {
      "id": "druidic",
      "name": "Druidic",
      "level": 1,
      "description": "You know Druidic, the secret language of druids. You can leave hidden messages that only druids can spot and decipher."
    },
    {
      "id": "wild_shape",
      "name": "Wild Shape",
      "level": 2,
      "description": "You can use your action to magically assume the shape of a beast that you have seen before, with CR and movement limitations that improve at druid levels 4 and 8.",
      "effects": [ { "type": "resource", "name": "Wild Shape", "uses": 2, "per": "short_rest" } ]
    },
    {
      "id": "druid_circle",
      "name": "Druid Circle",
      "level": 2,
      "description": "You choose a druid circle, such as Circle of the Land or Circle of the Moon.",
      "effects": [ { "type": "choose_subclass", "atLevel": 2 } ]
    },
    {
      "id": "ability_score_improvement",
      "name": "Ability Score Improvement",
      "level": 4,
      "description": "At 4th level, and again at 8th, 12th, 16th, and 19th level, you can increase one ability score by 2 or two ability scores by 1, or take a feat if used."
    },
    {
      "id": "timeless_body",
      "name": "Timeless Body",
      "level": 18,
      "description": "Your body ages more slowly, suffering none of the frailty of old age, and you can't be aged magically."
    },
    {
      "id": "beast_spells",
      "name": "Beast Spells",
      "level": 18,
      "description": "You can cast many of your druid spells in any shape you assume using Wild Shape, with material component restrictions."
    },
    {
      "id": "archdruid",
      "name": "Archdruid",
      "level": 20,
      "description": "You can use your Wild Shape an unlimited number of times. Additionally, ignore verbal and somatic components of druid spells while in a beast shape."
    }
  ],
