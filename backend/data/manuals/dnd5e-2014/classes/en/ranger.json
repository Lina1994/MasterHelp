    "hitDice": "1d10 per ranger level",
    "at1stLevel": "10 + your Constitution modifier",
    "atHigherLevels": "1d10 (or 6) + your Constitution modifier per ranger level after 1st"
  },
  "primaryAbilities": ["dex", "wis"],
  "savingThrows": ["str", "dex"],
  "proficiencies": {
    "armor": ["Light Armor", "Medium Armor", "Shields"],
    "weapons": ["Simple Weapons", "Martial Weapons"],
    "tools": ["Herbalism Kit"]
  },
  "skills": { "choose": 3, "from": ["Animal Handling", "Athletics", "Insight", "Investigation", "Nature", "Perception", "Stealth", "Survival"] },
  "equipment": [
    { "choose": 1, "options": [ { "id": "scale_mail", "description": "Scale mail" }, { "id": "leather_armor", "description": "Leather armor" } ] },
    { "choose": 1, "options": [ { "id": "two_shortswords", "description": "Two shortswords" }, { "id": "simple_melee_weapon_x2", "description": "Two simple melee weapons" } ] },
    { "choose": 1, "options": [ { "id": "dungeoneers_pack", "description": "Dungeoneer’s pack" }, { "id": "explorers_pack", "description": "Explorer’s pack" } ] },
    { "id": "longbow_with_quiver_arrows", "description": "A longbow and a quiver of 20 arrows" }
  ],
  "features": [
    { "id": "favored_enemy", "name": "Favored Enemy", "level": 1, "description": "You have significant experience studying, tracking, hunting, and even talking to a certain type of enemy." },
    { "id": "natural_explorer", "name": "Natural Explorer", "level": 1, "description": "You are particularly familiar with one type of natural environment and adept at traveling and surviving in such regions." },
    { "id": "fighting_style", "name": "Fighting Style", "level": 2, "description": "You adopt a particular style of fighting as your specialty.", "effects": [ { "type": "choose_fighting_style", "styles": ["Archery", "Defense", "Dueling", "Two-Weapon Fighting"] } ] },
    { "id": "ranger_spellcasting", "name": "Spellcasting", "level": 2, "description": "You learn to use the magical essence of nature to cast spells. WIS is your spellcasting ability.", "effects": [ { "type": "spellcasting", "ability": "wis", "progression": "half", "ritualCasting": false } ] },
    { "id": "primeval_awareness", "name": "Primeval Awareness", "level": 3, "description": "You can use your spell slots to focus your awareness on the region around you." },
    { "id": "ranger_archetype", "name": "Ranger Archetype", "level": 3, "description": "Choose an archetype that you strive to emulate, such as Hunter or Beast Master.", "effects": [ { "type": "choose_subclass", "atLevel": 3 } ] },
    { "id": "ability_score_improvement", "name": "Ability Score Improvement", "level": 4, "description": "At 4th level, and again at 8th, 12th, 16th, and 19th, increase one ability by 2, or two abilities by 1 each, or take a feat if used." },
    { "id": "extra_attack", "name": "Extra Attack", "level": 5, "description": "You can attack twice, instead of once, whenever you take the Attack action on your turn.", "effects": [ { "type": "extra_attack", "count": 1 } ] },
    { "id": "lands_stride", "name": "Land’s Stride", "level": 8, "description": "Moving through nonmagical difficult terrain costs you no extra movement." },
    { "id": "hide_in_plain_sight", "name": "Hide in Plain Sight", "level": 10, "description": "You can attempt to hide even when you are only lightly obscured and create camouflage." },
    { "id": "vanish", "name": "Vanish", "level": 14, "description": "You can use the Hide action as a bonus action on your turn, and you can’t be tracked by nonmagical means." },
    { "id": "feral_senses", "name": "Feral Senses", "level": 18, "description": "You gain preternatural senses that help you fight creatures you can’t see." },
    { "id": "foe_slayer", "name": "Foe Slayer", "level": 20, "description": "You become an unparalleled hunter of your enemies; add your WIS mod to attack or damage once per turn." }
