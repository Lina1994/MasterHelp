  "features": [
    {
      "id": "lanzamiento_conjuros",
      "name": "Lanzamiento de conjuros",
      "level": 1,
      "description": "Canalizando la esencia divina de la naturaleza misma, puedes lanzar conjuros para moldear esa esencia a tu voluntad. Tu habilidad de lanzamiento es Sabiduría. Cada día preparas una lista de conjuros de la lista de druida.",
      "effects": [
        {
          "type": "lanzamiento_ritual",
          "value": true
        },
        {
          "type": "espacios_conjuro_por_nivel",
          "ability": "wis",
          "lists": [
            "druida"
          ]
        }
      ]
    },
    {
      "id": "druidico",
      "name": "Druídico",
      "level": 1,
      "description": "Conoces el Druídico, el lenguaje secreto de los druidas. Puedes hablarlo y usarlo para dejar mensajes ocultos.",
      "effects": [
        {
          "type": "idioma_conocido",
          "value": "Druídico"
        }
      ]
    },
    {
      "id": "forma_salvaje",
      "name": "Forma salvaje",
      "level": 2,
      "description": "Puedes usar tu Forma Salvaje para transformarte en una bestia que hayas visto antes. Usas esta dote dos veces por descanso corto o largo; en niveles superiores obtienes más usos y puedes transformarte en bestias más poderosas. Permaneces en forma salvaje un número de horas igual a la mitad de tu nivel de druida, luego reviertes. Puedes revertir antes como acción adicional.",
      "effects": [
        {
          "type": "forma_salvaje",
          "max_cr": {
            "2": 0.25,
            "4": 0.5,
            "8": 1,
            "20": null
          },
          "restriction": "sin_volar_nadar_inicio_nivel_4",
          "uses": "descanso_corto",
          "useScaling": {
            "2": 2
          }
        }
      ]
    },
    {
      "id": "compania_salvaje",
      "name": "Compañero salvaje (opcional Nivel 2)",
      "level": 2,
      "description": "Puedes invocar un espíritu que adopta la forma de una bestia (ND 1/4 o inferior, sin velocidad de vuelo ni natación). Te sirve de montura o guardián. Se recarga en descanso largo.",
      "effects": [
        {
          "type": "invocar_companiero_truco",
          "ref": "hallar_familiar"
        }
      ]
    },
    {
      "id": "conjuros_circulo",
      "name": "Conjuros de círculo",
      "level": 3,
      "description": "Al unirte a un Círculo druídico, aprendes conjuros adicionales en niveles específicos.",
      "effects": [
        {
          "type": "preparar_conjuros_circulo_siempre"
        }
      ]
    },
    {
      "id": "mejora_puntuacion_caracteristica",
      "name": "Mejora de puntuación de característica",
      "level": 4,
      "description": "Aumentas una puntuación de característica en 2, o dos en 1. Máximo 20.",
      "effects": [
        {
          "type": "asi",
          "value": "2/1+1",
          "max": 20
        }
      ]
    },
    {
      "id": "ataque_adicional",
