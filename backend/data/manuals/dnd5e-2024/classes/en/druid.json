  "features": [
    {
      "id": "spellcasting",
      "name": "Spellcasting",
      "level": 1,
      "description": "Drawing on the divine essence of nature itself, you can cast spells to shape that essence to your will. Your spellcasting ability is Wisdom. You prepare the list of druid spells available to cast each day.",
      "effects": [
        {
          "type": "ritual_casting",
          "value": true
        },
        {
          "type": "spell_slots_by_level",
          "ability": "wis",
          "lists": [
            "druid"
          ]
        }
      ]
    },
    {
      "id": "druidic",
      "name": "Druidic",
      "level": 1,
      "description": "You know Druidic, the secret language of druids. You can speak it and use it to leave hidden messages.",
      "effects": [
        {
          "type": "language_known",
          "value": "Druidic"
        }
      ]
    },
    {
      "id": "wild_shape",
      "name": "Wild Shape",
      "level": 2,
      "description": "You can use your Wild Shape to transform into a beast you have seen before. You can use this feature twice per short or long rest; at higher levels you gain more uses and can transform into more powerful beasts. You can stay in Wild Shape for a number of hours equal to half your druid level, then revert. You can revert early as a bonus action.",
      "effects": [
        {
          "type": "wild_shape",
          "max_cr": {
            "2": 0.25,
            "4": 0.5,
            "8": 1,
            "20": null
          },
          "restriction": "no_flying_swimming_speed_starting_4",
          "uses": "short_rest",
          "useScaling": {
            "2": 2
          }
        }
      ]
    },
    {
      "id": "wild_companion",
      "name": "Wild Companion (Optional 2nd-level feature)",
      "level": 2,
      "description": "You can summon a spirit that takes the form of a Beast (CR 1/4 or lower, no flying or swimming speed). It serves you as a mount or guard. Recharges on a long rest.",
      "effects": [
        {
          "type": "summon_companion_cantrip",
          "ref": "find_familiar"
        }
      ]
    },
    {
      "id": "circle_spells",
      "name": "Circle Spells",
      "level": 3,
      "description": "When you join a druidic Circle, you learn additional spells at specific druid levels.",
      "effects": [
        {
          "type": "prepares_circle_spells_always"
        }
      ]
    },
    {
      "id": "ability_score_improvement",
      "name": "Ability Score Improvement",
      "level": 4,
      "description": "You can increase one ability score by 2, or two ability scores by 1. Max 20.",
      "effects": [
        {
          "type": "asi",
          "value": "2/1+1",
          "max": 20
        }
      ]
    },
    {
      "id": "extra_attack",
      "name": "Extra Attack",
      "level": 5,
      "description": "You can attack twice, instead of once, whenever you take the Attack action on your turn. The extra attack doesn't combine with Wild Shape attacks if carried out in the same Combat Phase.",
      "effects": [
        {
          "type": "extra_attack",
          "count": 1
        }
      ]
    },
    {
      "id": "wild_shape_improvement",
      "name": "Wild Shape Improvement",
      "level": 4,
      "description": "You can use Wild Shape to transform into a beast with a CR up to 1/2 and that has a swimming speed.",
      "effects": [
        {
          "type": "wild_shape_max_cr_increase",
          "to": 0.5
        }
      ]
    },
    {
      "id": "wild_shape_improvement_8",
      "name": "Wild Shape Improvement",
      "level": 8,
      "description": "You can transform into a beast with a CR up to 1 (and gains flying speed).",
      "effects": [
        {
          "type": "wild_shape_max_cr_increase",
          "to": 1,
          "allow_flying": true
        }
      ]
    },
    {
      "id": "circle_feature_2",
      "name": "Circle Feature (2nd)",
      "level": 6,
      "description": "You gain a feature from your Circle.",
      "effects": [
        {
          "type": "subclass_feature",
          "ref": "circle_2"
