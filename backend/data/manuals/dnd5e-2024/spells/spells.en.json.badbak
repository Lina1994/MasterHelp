    "range": "60 feet",
    "duration": "Instantaneous",
    "components": "V, S",
    "classes": [
      "Sorcerer",
      "Wizard"
    ],
    "description": "You hurl a bubble of acid. Choose one creature within range, or two within 5 feet of each other. Targets take 1d6 acid damage on a failed Dexterity save. Cantrip upgrade: 2d6 at 5th, 3d6 at 11th, 4d6 at 17th level.",
    "savingThrow": "Dexterity"
  },
  {
    "id": "blade_ward",
    "name": "Blade Ward",
    "level": 0,
    "school": "Abjuration",
    "castingTime": "Action",
    "range": "Self",
    "duration": "1 round",
    "components": "V, S",
    "classes": [
      "Sorcerer",
      "Warlock",
      "Wizard"
    ],
    "description_en": "You extend your hand and trace a sigil of warding in the air. Until the end of your next turn, you have resistance against bludgeoning, piercing, and slashing damage dealt by weapon attacks.",
    "description_es": "Extiendes la mano y trazas un sigilo de protección en el aire. Hasta el final de tu próximo turno, tienes resistencia al daño contundente, perforante y cortante de ataques con armas."
  },
  {
